# ==============================================================
# OpenProject → Telegram Webhook Forwarder Configuration
# ==============================================================
# Copy this file to .env and fill in your values.

# [REQUIRED] Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# [REQUIRED] Target Telegram Chat ID
# For personal chat: your numeric user ID (get from @userinfobot)
# For group: group chat ID (usually negative number, e.g. -1001234567890)
# For channel: channel chat ID or @channel_username
TELEGRAM_CHAT_ID=-1001234567890

# [OPTIONAL] Webhook signature secret for verifying OpenProject requests
# Must match the secret configured in OpenProject webhook settings.
# WEBHOOK_SECRET=your-shared-secret-here

# [OPTIONAL] Base URL of your OpenProject instance (for generating links)
# Example: https://openproject.example.com
# OPENPROJECT_URL=https://openproject.example.com

# [OPTIONAL] HTTP server port (default: 8080)
# PORT=8080
